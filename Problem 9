#include <iostream>
using namespace std;

bool isPalindrome(int n);

int main() {
    int n;
    cin >> n;
    long long sum = 0;
    for (int i = 1; i <= n; i++) {
        if (isPalindrome(i))
            sum += i;
    }
    cout << sum << endl;
    return 0;
}

bool isPalindrome(int n) {
    int original = n, reversed = 0;
    while (n > 0) {
        reversed = reversed * 10 + n % 10;
        n /= 10;
    }
    return original == reversed;
}
