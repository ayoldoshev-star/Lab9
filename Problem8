#include <iostream>
using namespace std;

int main() {
    long long n;
    cin >> n;
    long long prod = 1;
    int maxDigit = 0;
    while (n > 0) {
        int d = n % 10;
        if (d != 0)
            prod *= d;
        if (d > maxDigit)
            maxDigit = d;
        n /= 10;
    }
    cout << prod << " " << maxDigit << endl;
    return 0;
}
